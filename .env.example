# Marca: o nome do produto existe só aqui (nenhum nome fixo no código)
APP_NAME="[Nome da rede]"
APP_SLUG=rede
APP_DOMAIN=localhost:3000
APP_URL=http://localhost:3000
APP_MAIL_FROM="Nome <no-reply@seudominio.org>"

# Banco (use a URL com pooling do provedor em produção)
DATABASE_URL=postgres://usuario:senha@host:5432/banco

# 32 bytes em base64: openssl rand -base64 32  (criptografa o segredo do 2FA; guarde como segredo do provedor)
DATA_ENCRYPTION_KEY=

# E-mail transacional (sem isto, os e-mails vão para o log, só em desenvolvimento)
RESEND_API_KEY=
